API_PORT=3000

# Redis
REDIS_ADDRESS=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Azure Service Bus
AZURE_SERVICEBUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
AZURE_SERVICEBUS_QUEUE=go-template-messages
AZURE_SERVICEBUS_TOPIC=go-template-events
AZURE_SERVICEBUS_SUBSCRIPTION=go-template-worker

# MongoDB
MONGODB_URL=localhost
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_ARGS=authSource=admin
MONGODB_DATABASE=go-template
MONGODB_PORT=27017
MONGODB_SERVER_SELECTION_TIMEOUT_SECONDS=3
MONGODB_PING_TIMEOUT_SECONDS=3
